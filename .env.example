# ---- runtime -------------------------------------------------------
# local = in-memory ledger + mock connectors + deterministic reasoner (no GCP needed)
# cloud = Firestore + Pub/Sub + Model Armor, with AI Studio or Vertex AI
ATLAS_MODE=local

# ---- google cloud (required when ATLAS_MODE=cloud) -----------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Set GOOGLE_GENAI_USE_VERTEXAI=false to use this key locally or on Cloud Run.
# Never commit a real key. The deploy script stores it in Secret Manager.
GEMINI_API_KEY=

# ---- models ---------------------------------------------------------
ATLAS_MODEL_FAST=gemini-3.5-flash
ATLAS_MODEL_JUDGE=gemini-3.5-flash
ATLAS_MODEL_REDACTOR=gemma-3-12b-it

# ---- infra ----------------------------------------------------------
ATLAS_BUCKET=
ATLAS_TOPIC_EVENTS=atlas-events
ATLAS_TOPIC_WORK=atlas-work

# ---- governance -----------------------------------------------------
ATLAS_ARMOR_INGRESS=atlas-ingress-strict
ATLAS_ARMOR_EGRESS=atlas-egress-pii
ATLAS_USE_MANAGED_ARMOR=true
ATLAS_ENABLE_TTS=false
ATLAS_TRUST_DOMAIN=atlas.dev
ATLAS_RUN_BUDGET_USD=50
ATLAS_COST_PER_CONTROL_USD=0.0031
ATLAS_HANDOFF_SLA_HOURS=72

# ---- optional live connectors (mocked when absent) ------------------
GITHUB_TOKEN=
GITHUB_ORG=
SLACK_BOT_TOKEN=
